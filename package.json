{
  "name": "wayan-sync",
  "version": "0.2.0",
  "description": "Sincroniza productos de WooCommerce con un Excel en OneDrive (pull / push) con panel web",
  "private": true,
  "main": "src/server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "create-user": "node scripts/create-user.js",
    "reset-password": "node scripts/reset-password.js",
    "login": "node src/cli.js login",
    "pull": "node src/cli.js pull",
    "push": "node src/cli.js push"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.1",
    "sharp": "^0.33.5"
  }
}
