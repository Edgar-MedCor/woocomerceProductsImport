# --- Panel ---
PORT=3000
# Cadena larga y aleatoria (obligatoria en producción)
SESSION_SECRET=
# Base creada con scripts/setup-db.sql
DATABASE_URL=postgresql://wayan_sync:test2026@localhost:5432/wayan_sync

# --- WooCommerce ---
# WooCommerce > Ajustes > Avanzado > REST API > Agregar clave (permisos Lectura/Escritura)
WOO_URL=http://wayan.local
WOO_KEY=
WOO_SECRET=
# Idioma principal de WPML (las traducciones no se exportan)
WOO_LANG=es
# Peticiones en paralelo al leer variaciones (bájalo si la tienda responde 502)
WOO_CONCURRENCY=5
# IP del servidor real de la tienda: las peticiones van directo y no pasan por el
# CDN de Hostinger (que corta con 429). Vacío = por el dominio, como siempre.
WOO_ORIGIN_IP=

# --- WordPress (para subir fotos a la biblioteca de medios) ---
# wp-admin > Usuarios > tu perfil > Contraseñas de aplicación
WP_USER=
WP_APP_PASSWORD=

# Carpeta raíz en SharePoint/OneDrive: pega el vínculo de la carpeta ("Copiar vínculo").
# Vacío = OneDrive de la cuenta conectada. Con vínculo, las rutas de abajo son relativas a esa carpeta.
ONEDRIVE_ROOT_URL=

# --- Fotos en OneDrive ---
# Carpeta con las fotos pendientes:
#   <categorías...>/<SKU producto>/1.webp, 2.webp...   -> galería
#   <SKU producto variable>/<Color>/1.webp             -> foto de las variaciones de ese color
#   <SKU producto variable>/<SKU variación>/1.webp     -> foto de esa variación
PHOTOS_PENDING_PATH=4.Sitio Web/Falta subir
# A dónde se mueven las carpetas ya subidas (misma ruta de categorías)
PHOTOS_DONE_PATH=4.Sitio Web/Subidas
# Cambio de prefijo de las carpetas de categoría al moverlas ("F.S. Ropa Dama" -> "S. Ropa Dama")
PHOTOS_DONE_RENAME="F.S. =>S. "
# replace = la galería queda igual a la carpeta | append = agrega a las fotos que ya tiene
PHOTOS_MODE=replace
# Lado mayor máximo en píxeles al reducir las fotos
PHOTOS_MAX_SIDE=2000
# Productos por ejecución (las demás quedan para la siguiente tanda)
PHOTOS_MAX_SKUS=300

# --- Microsoft / OneDrive ---
# App registrada en Azure (no es secreto)
MS_CLIENT_ID=1817ecc4-2f29-472a-8c89-bf65a49ee430
# consumers = OneDrive personal | organizations o <id del directorio> = Microsoft 365 empresa
MS_AUTHORITY=consumers
# Ruta del Excel dentro de OneDrive
ONEDRIVE_EXCEL_PATH=Wayan Sync/Productos.xlsx
